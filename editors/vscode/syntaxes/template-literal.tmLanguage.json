{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "jq79.injection.template-literal",
  "comment": "Template literals that hold another language: the source passed to Component79(`\u2026`), C79(`\u2026`) or parseComponent(`\u2026`), and a literal tagged with the language's name (html`\u2026`, css`\u2026`, ts`\u2026`). ${\u2026} inside them is jq79.injection.template-substitution's, so it works at any depth of the embedded language (an attribute value included).",
  "injectionSelector": "L:source.js -comment -string, L:source.js meta.template.expression -comment, L:source.ts -comment -string, L:source.ts meta.template.expression -comment, L:source.tsx -comment -string, L:source.tsx meta.template.expression -comment",
  "patterns": [
    {
      "include": "#component79"
    },
    {
      "include": "#tagged-html"
    },
    {
      "include": "#tagged-css"
    },
    {
      "include": "#tagged-scss"
    },
    {
      "include": "#tagged-less"
    },
    {
      "include": "#tagged-js"
    },
    {
      "include": "#tagged-ts"
    }
  ],
  "repository": {
    "component79": {
      "comment": "the source handed to Component79 (or its alias C79, or parseComponent) is a component: HTML, with its own <script> and <style> blocks. Matched from the backtick (the lookbehind leaves `Component79(` to the JS grammar), so the string has to open on the same line as the call",
      "begin": "(?<=\\bComponent79\\(|\\bComponent79\\s\\(|\\bC79\\(|\\bC79\\s\\(|\\bparseComponent\\(|\\bparseComponent\\s\\()\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "string.template.js punctuation.definition.string.template.begin.js"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "string.template.js punctuation.definition.string.template.end.js"
        }
      },
      "name": "meta.embedded.template-literal.jq79",
      "contentName": "meta.embedded.block.html text.html.basic",
      "patterns": [
        {
          "include": "text.html.derivative"
        }
      ]
    },
    "tagged-html": {
      "begin": "(?<![\\w$])(html|svg)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.js"
        },
        "2": {
          "name": "string.template.js punctuation.definition.string.template.begin.js"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "string.template.js punctuation.definition.string.template.end.js"
        }
      },
      "name": "meta.embedded.template-literal.jq79",
      "contentName": "meta.embedded.block.html text.html.basic",
      "patterns": [
        {
          "include": "text.html.derivative"
        }
      ]
    },
    "tagged-css": {
      "begin": "(?<![\\w$])(css)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.js"
        },
        "2": {
          "name": "string.template.js punctuation.definition.string.template.begin.js"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "string.template.js punctuation.definition.string.template.end.js"
        }
      },
      "name": "meta.embedded.template-literal.jq79",
      "contentName": "meta.embedded.block.css source.css",
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "tagged-scss": {
      "begin": "(?<![\\w$])(scss)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.js"
        },
        "2": {
          "name": "string.template.js punctuation.definition.string.template.begin.js"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "string.template.js punctuation.definition.string.template.end.js"
        }
      },
      "name": "meta.embedded.template-literal.jq79",
      "contentName": "meta.embedded.block.scss source.css.scss",
      "patterns": [
        {
          "include": "source.css.scss"
        }
      ]
    },
    "tagged-less": {
      "begin": "(?<![\\w$])(less)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.js"
        },
        "2": {
          "name": "string.template.js punctuation.definition.string.template.begin.js"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "string.template.js punctuation.definition.string.template.end.js"
        }
      },
      "name": "meta.embedded.template-literal.jq79",
      "contentName": "meta.embedded.block.less source.css.less",
      "patterns": [
        {
          "include": "source.css.less"
        }
      ]
    },
    "tagged-js": {
      "begin": "(?<![\\w$])(js|javascript)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.js"
        },
        "2": {
          "name": "string.template.js punctuation.definition.string.template.begin.js"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "string.template.js punctuation.definition.string.template.end.js"
        }
      },
      "name": "meta.embedded.template-literal.jq79",
      "contentName": "meta.embedded.block.js source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "tagged-ts": {
      "begin": "(?<![\\w$])(ts|typescript)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.js"
        },
        "2": {
          "name": "string.template.js punctuation.definition.string.template.begin.js"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "string.template.js punctuation.definition.string.template.end.js"
        }
      },
      "name": "meta.embedded.template-literal.jq79",
      "contentName": "meta.embedded.block.ts source.ts",
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    }
  }
}
