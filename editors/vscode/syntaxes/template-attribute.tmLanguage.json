                            },
                            "5": {
                              "name": "meta.brace.round.js"
                            },
                            "6": {
                              "name": "keyword.operator.expression.in.js"
                            }
                          }
                        },
                        {
                          "include": "source.js#expression"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "begin": "'",
              "beginCaptures": {
                "0": {
                  "name": "string.quoted.single.html punctuation.definition.string.begin.html"
                }
              },
              "end": "'",
              "endCaptures": {
                "0": {
                  "name": "string.quoted.single.html punctuation.definition.string.end.html"
                }
              },
              "contentName": "meta.embedded.expression.jq79 source.js",
              "patterns": [
                {
                  "match": "[^']+",
                  "captures": {
                    "0": {
                      "patterns": [
                        {
                          "match": "(?<=^|[\"'=])\\s*(\\()?\\s*([\\w$]+)\\s*(?:(,)\\s*([\\w$]+))?\\s*(\\))?\\s+(in)(?![\\w$])",
                          "captures": {
                            "1": {
                              "name": "meta.brace.round.js"
                            },
                            "2": {
                              "name": "variable.parameter.js"
                            },
                            "3": {
                              "name": "punctuation.separator.comma.js"
                            },
                            "4": {
                              "name": "variable.parameter.js"
                            },
                            "5": {
                              "name": "meta.brace.round.js"
                            },
                            "6": {
                              "name": "keyword.operator.expression.in.js"
                            }
                          }
                        },
                        {
                          "include": "source.js#expression"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "comment": "unquoted: one token, so a capture's patterns read it and nothing can run past it",
              "match": "([^\\s\"'=<>`/]|/(?!>))+",
              "name": "meta.embedded.expression.jq79 source.js",
              "captures": {
                "0": {
                  "patterns": [
                    {
                      "match": "(?<=^|[\"'=])\\s*(\\()?\\s*([\\w$]+)\\s*(?:(,)\\s*([\\w$]+))?\\s*(\\))?\\s+(in)(?![\\w$])",
                      "captures": {
                        "1": {
                          "name": "meta.brace.round.js"
                        },
                        "2": {
                          "name": "variable.parameter.js"
                        },
                        "3": {
