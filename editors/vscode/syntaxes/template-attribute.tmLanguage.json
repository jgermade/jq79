      "match": "(?<![^\\s])(\\.\\.\\.)([A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*)(?=[\\s/>]|$)",
      "name": "meta.attribute.spread.jq79",
      "captures": {
