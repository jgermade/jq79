{
  "name": "jq79-vscode",
  "displayName": "jq79",
  "description": "jq79 components in VS Code: their scripts and templates checked, completed and hovered as the runtime compiles them, and {{ }}, :attr, @event, <script lang=\"ts\">, <style lang=\"scss\"> and Component79(`…`) colored in their language",
  "version": "0.12.0",
  "publisher": "jgermade",
  "license": "ISC",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgermade/jq79.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "jq79",
    "html",
    "typescript",
    "scss",
    "template literal"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "jq79-check": "./dist/check.mjs"
  },
  "activationEvents": [
    "onLanguage:html"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "jq79.injection.script-lang",
        "path": "./syntaxes/script-lang.tmLanguage.json",
        "injectTo": [
          "text.html.derivative",
          "text.html.basic",
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "source.ts": "typescript"
        }
      },
      {
        "scopeName": "jq79.injection.style-lang",
        "path": "./syntaxes/style-lang.tmLanguage.json",
        "injectTo": [
          "text.html.derivative",
          "text.html.basic",
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "source.css.scss": "scss",
          "source.css.less": "less",
          "source.sass": "sass",
          "source.stylus": "stylus"
        }
      },
      {
        "scopeName": "jq79.injection.template-literal",
        "path": "./syntaxes/template-literal.tmLanguage.json",
        "injectTo": [
          "text.html.derivative",
          "text.html.basic",
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "text.html.basic": "html",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.css.less": "less",
          "source.js": "javascript",
          "source.ts": "typescript"
        }
      },
      {
        "scopeName": "jq79.injection.template-substitution",
        "path": "./syntaxes/template-substitution.tmLanguage.json",
        "injectTo": [
          "text.html.derivative",
          "text.html.basic",
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.line.js": "javascript"
        }
      },
      {
        "scopeName": "jq79.injection.template-attribute",
        "path": "./syntaxes/template-attribute.tmLanguage.json",
        "injectTo": [
          "text.html.derivative",
          "text.html.basic",
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.expression.jq79": "javascript",
          "meta.embedded.parameters.jq79": "typescript"
        }
      },
      {
        "scopeName": "jq79.injection.template-interpolation",
        "path": "./syntaxes/template-interpolation.tmLanguage.json",
        "injectTo": [
          "text.html.derivative",
          "text.html.basic",
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.expression.jq79": "javascript"
        }
      }
    ],
    "configurationDefaults": {
      "html.validate.scripts": false
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "vscode:prepublish": "node build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p .",
    "pretest": "node test/fetch-grammars.mjs && node build.mjs && node node_modules/typescript/bin/tsc -p .",
    "test": "node --test test/grammars.mjs test/check.mjs test/server.mjs test/cli.mjs && JQ79_CHECKER=ts7 node --test test/check.mjs",
    "check": "node dist/check.mjs",
    "package": "npx --yes @vscode/vsce package --skip-license"
  },
  "dependencies": {
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.82.0",
    "@volar/kit": "~2.4.28",
    "@volar/language-core": "~2.4.28",
    "@volar/language-server": "~2.4.28",
    "@volar/language-service": "~2.4.28",
    "@volar/typescript": "~2.4.28",
    "esbuild": "^0.28.2",
    "typescript7": "npm:typescript@7.0.2",
    "volar-service-css": "^0.0.71",
    "volar-service-typescript": "^0.0.71",
    "vscode-languageclient": "^9.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vscode-uri": "^3.2.0"
  }
}
